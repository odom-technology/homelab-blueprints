{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/service-metadata.schema.json",
  "title": "Homelab service metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "owner", "purpose", "placement", "recovery_priority", "backup_class"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "owner": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "placement": {"type": "string", "minLength": 1},
    "recovery_priority": {"type": "integer", "minimum": 1, "maximum": 5},
    "backup_class": {
      "type": "string",
      "enum": ["critical-data", "critical-configuration", "application-defined", "rebuild-only", "none"]
    },
    "exposure": {"type": "string"},
    "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "listeners": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
